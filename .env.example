# ===== ZED GIFT SHOP — ENVIRONMENT VARIABLES =====
# Copy to `.env` and fill in real values. NEVER commit real secrets.

# ---- Supabase (target database and authentication) ----
# Get the project URL and publishable key from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Optional server-side aliases; never expose the secret key to browser code.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Server-only administrative key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""

# ---- Legacy database (temporary during Prisma-to-Supabase migration) ----
# Remove DATABASE_URL and the zedgiftshop_POSTGRES_* variables after all Prisma
# queries, scripts and migrations have been replaced and the build is verified.
DATABASE_URL="postgresql://postgres:zedgift-shop@127.0.0.1:5432/zedgift"

# ---- Auth ----
# Long random string (min 32 chars). Used to sign session cookies & password hashes.
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- Site ----
# Public origin used for emails, canonical URLs, absolute links & M-Pesa callbacks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
MPESA_CALLBACK_URL="http://localhost:3000/api/payments/mpesa/callback"

# ---- M-PESA (Daraja / Safaricom) ----
# MPESA_ENV: "sandbox" during development, "production" for live.
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE="174379"
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
# Optional: for paybill-verified lookups.
MPESA_BUSINESS_SHORTCODE=""
MPESA_WEBHOOK_SECRET=""

# ---- Email / notifications ----
# Provider: "resend" (fetch-based REST) or "smtp" (nodemailer).
EMAIL_PROVIDER="resend"
EMAIL_FROM="ZED GIFT SHOP 2 <orders@zedgiftshop2.com>"
EMAIL_API_KEY=""
# SMTP (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ---- File uploads ----
# Uses Vercel Blob when a token is present; otherwise falls back to /public/uploads in dev.
BLOB_READ_WRITE_TOKEN=""

# ---- Rate limiting (Upstash Redis; optional. Falls back to in-memory burst limit.) ----
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# ---- Flutterwave (hosted checkout) ----
FLUTTERWAVE_ENV="sandbox"
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_ENCRYPTION_KEY=""
FLUTTERWAVE_CALLBACK_URL=""
