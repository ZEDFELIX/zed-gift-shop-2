// ZED GIFT SHOP - PostgreSQL schema (Prisma)

generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
 url = env("zedgiftshop2_PRISMA_DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
 CUSTOMER
 STAFF
 ADMIN
}

enum UserStatus {
 ACTIVE
 SUSPENDED
 DISABLED
}

enum ProductStatus {
 DRAFT
 ACTIVE
 ARCHIVED
}

enum CategoryKind {
 CATEGORY
 OCCASION
 RECIPIENT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  CUSTOMIZATION
  PACKED
  READY_FOR_DISPATCH
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  TIMEOUT
  REFUNDED
  REVERSED
}

enum PaymentProvider {
  M_PESA
  MANUAL
  CARD
  FLUTTERWAVE
  BANK_TRANSFER
  COD
}

enum DeliveryMethod {
 SAME_DAY
 NEXT_DAY
 STANDARD
 EXPRESS
 PICKUP
}

enum DiscountType {
 PERCENTAGE
 FIXED
}

enum DiscountScope {
 ALL
 PRODUCT
 CATEGORY
 COLLECTION
}

enum InventoryTxnType {
 IN
 OUT
 ADJUST
 RESERVE
 RELEASE
}

enum ReviewStatus {
 PENDING
 APPROVED
 REJECTED
}

enum OccasionType {
 BIRTHDAY
 ANNIVERSARY
 WEDDING
 GRADUATION
 VALENTINES
 MOTHERS_DAY
 FATHERS_DAY
 CHRISTMAS
 OTHER
}

enum NotificationType {
  ORDER
  PAYMENT
  DELIVERY
  REMINDER
  MARKETING
  REVIEW
  SYSTEM
}

/// Customer-visible notification events. One row is attempted per event and
/// channel so a provider outage never silently loses the record.
enum NotificationEvent {
  ORDER_RECEIVED
  PAYMENT_CONFIRMED
  ORDER_PROCESSING
  ORDER_PACKED
  ORDER_DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  PAYMENT_FAILED
  ORDER_CANCELLED
  REFUND_PROCESSED
  // Admin-facing operational alerts.
  ADMIN_NEW_ORDER
  ADMIN_FAILED_PAYMENT
  ADMIN_LOW_STOCK
  ADMIN_OUT_OF_STOCK
  ADMIN_NEW_CUSTOMER
  ADMIN_NEW_REVIEW
  ADMIN_NEW_REFUND_REQUEST
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

// ---------- Accounts ----------

model User {
 id String @id @default(cuid())
 name String
 email String @unique
 emailVerified DateTime?
 passwordHash String?
 phone String?
 role Role @default(CUSTOMER)
 status UserStatus @default(ACTIVE)
 favoritesJson String?
 // Authentication hardening: lockout after repeated failures + activity trail.
 failedLoginAttempts Int @default(0)
 lockedUntil DateTime?
 lastLoginAt DateTime?
 lastLoginIp String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 wishlist Wishlist?
 addresses Address[]
 orders Order[]
 reviews Review[]
 reminders OccasionReminder[]
 notifications Notification[]
 inventoryTransactions InventoryTransaction[]
 passwordResets PasswordReset[]
 groupMemberships CustomerGroupMember[]

 @@index([role])
 @@index([status])
 @@index([createdAt])
}

model PasswordReset {
 id String @id @default(cuid())
 userId String
 tokenHash String @unique
 expiresAt DateTime
 usedAt DateTime?
 createdAt DateTime @default(now())

 user User @relation(fields: [userId], references: [id], onDelete: Cascade)

 @@index([userId])
}

model Address {
  id String @id @default(cuid())
  userId String
  label String?
  fullName String
  phone String
  county String
  town String
  area String?
  street String?
  address String
  building String?
  apartment String?
  landmark String?
  deliveryInstructions String?
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id String @id @default(cuid())
  userId String
  type NotificationType @default(SYSTEM)
  event NotificationEvent
  channel NotificationChannel @default(EMAIL)
  title String
  body String
  toEmail String?
  toPhone String?
  provider String?
  providerMessageId String?
  providerResponseJson String?
  status NotificationDeliveryStatus @default(QUEUED)
  error String?
  read Boolean @default(false)
  sentAt DateTime?
  deliveredAt DateTime?
  failedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([event])
  @@index([channel])
  @@index([status])
}

// ---------- Catalogue ----------

model Category {
 id String @id @default(cuid())
 slug String @unique
 name String
 description String?
 image String?
 kind CategoryKind @default(CATEGORY)
 parentId String?
 parent Category? @relation("CategoryTree", fields: [parentId], references: [id])
 children Category[] @relation("CategoryTree")
 sortOrder Int @default(0)
 active Boolean @default(true)
 seoTitle String?
 seoDescription String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 products ProductCategory[]
 coupons Coupon[] @relation("CouponCategories")

 @@index([kind])
}

model Collection {
 id String @id @default(cuid())
 slug String @unique
 name String
 description String?
 image String?
 featured Boolean @default(false)
 seoTitle String?
 seoDescription String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 products ProductCollection[]
 coupons Coupon[] @relation("CouponCollections")
}

model Product {
 id String @id @default(cuid())
 slug String @unique
 name String
 headline String?
 description String?
 shortDescription String?
 price Int
 compareAtPrice Int?
 sku String?
 tags String[] @default([])
 status ProductStatus @default(DRAFT)
 featured Boolean @default(false)
 bestSeller Boolean @default(false)
 publishedAt DateTime?
 // Inventory
 trackInventory Boolean @default(true)
 quantity Int @default(0)
 reservedQuantity Int @default(0)
 lowStockThreshold Int @default(5)
 // Personalization configuration
 personalizationEnabled Boolean @default(false)
 personalizationFieldsJson String?
 giftWrapAvailable Boolean @default(false)
 giftMessageAvailable Boolean @default(true)
 // Ratings
 ratingCount Int @default(0)
 ratingAverage Float @default(0)
// Delivery note
  deliveryNote String?
  // Fragile or high-value items can be excluded from cash on delivery.
  codEligible Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

 categories ProductCategory[]
 collections ProductCollection[]
 variants ProductVariant[]
 images ProductImage[]
 reviews Review[]
 orderItems OrderItem[]
 coupons Coupon[] @relation("CouponProducts")
 cartItems CartItem[]
 wishlistItems WishlistItem[]
 inventoryTransactions InventoryTransaction[]

 @@index([status])
 @@index([featured])
 @@index([bestSeller])
}

model ProductVariant {
 id String @id @default(cuid())
 productId String
 name String
 value String
 sku String @unique
 priceOffset Int @default(0)
 quantity Int @default(0)
 reservedQuantity Int @default(0)
 optionsJson String?
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
 orderItems OrderItem[]
 cartItems CartItem[]
 wishlistItems WishlistItem[]
 inventoryTransactions InventoryTransaction[]

 @@index([productId])
}

model ProductImage {
 id String @id @default(cuid())
 productId String
 url String
 alt String?
 sortOrder Int @default(0)
 isPrimary Boolean @default(false)
 createdAt DateTime @default(now())

 product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

 @@index([productId])
}

model ProductCategory {
 productId String
 categoryId String
 sortOrder Int @default(0)

 product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
 category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

 @@id([productId, categoryId])
 @@index([categoryId])
}

model ProductCollection {
 productId String
 collectionId String
 sortOrder Int @default(0)

 product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
 collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

 @@id([productId, collectionId])
 @@index([collectionId])
}

// ---------- Cart (server-side, syncs for signed-in customers) ----------

model Cart {
 id String @id @default(cuid())
 userId String? @unique
 sessionId String @unique
 couponCode String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 items CartItem[]
}

model CartItem {
 id String @id @default(cuid())
 cartId String
 productId String
 variantId String?
 quantity Int @default(1)
 personalizationJson String?
 giftWrapJson String?
 giftMessageJson String?
 savedForLater Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
 product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
 variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

 @@index([cartId])
}

model Wishlist {
 id String @id @default(cuid())
 userId String @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 items WishlistItem[]
}

model WishlistItem {
 id String @id @default(cuid())
 wishlistId String
 productId String
 variantId String?
 createdAt DateTime @default(now())

 wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
 product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
 variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

 @@unique([wishlistId, productId])
 @@index([productId])
}

// ---------- Orders ----------

model Order {
 id String @id @default(cuid())
 orderNumber String @unique
 userId String?
 name String
 email String
 phone String
 // Totals (in whole KES, always computed server-side)
 subtotal Int
 discount Int @default(0)
 deliveryFee Int @default(0)
 total Int
 couponCode String?
 couponId String?
// Delivery (Kenyan address structure)
  deliveryMethod DeliveryMethod
  county String
  town String
  area String?
  street String?
  address String
  building String?
  apartment String?
  landmark String?
  deliveryInstructions String?
  deliveryPartner String?
  expectedDeliveryDate DateTime?
  // Status
  orderStatus OrderStatus @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING)
  isGift Boolean @default(false)
  paidAt DateTime?
  cancelledAt DateTime?
  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]
  payments Payment[]
  refunds Refund[]
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  reviews Review[]

  @@index([orderNumber])
  @@index([email])
  @@index([phone])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([county])
}

model OrderItem {
 id String @id @default(cuid())
 orderId String
 productId String?
 variantId String?
 name String
 sku String?
 image String?
 price Int
 quantity Int
 giftWrapPrice Int @default(0)
 personalizationJson String?
 giftWrapJson String?
 giftMessageJson String?
 createdAt DateTime @default(now())

 personalization Personalization?
 giftMessage GiftMessage?
 order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
 product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
 variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

 @@index([orderId])
}

model Personalization {
 id String @id @default(cuid())
 orderItemId String @unique
 productName String
 dataJson String
 createdAt DateTime @default(now())

 orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model GiftMessage {
 id String @id @default(cuid())
 orderItemId String @unique
 message String
 fromName String?
 toName String?
 createdAt DateTime @default(now())

 orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model GiftWrap {
 id String @id @default(cuid())
 name String
 sku String? @unique
 price Int
 image String?
 description String?
 active Boolean @default(true)
 sortOrder Int @default(0)
 createdAt DateTime @default(now())
}

// ---------- Payments ----------

model Payment {
  id String @id @default(cuid())
  orderId String
  provider PaymentProvider @default(M_PESA)
  status PaymentStatus @default(PENDING)
  amount Int
  currency String @default("KES")
  phone String
  email String?
  // Guard against a replayed STK push creating a second charge.
  idempotencyKey String? @unique
  // Daraja identifiers
  merchantRequestId String?
  checkoutRequestId String? @unique
  mpesaReceipt String? @unique
  transactionCode String? @unique
  // Flutterwave identifiers
  txRef String? @unique
  transactionId String? @unique
  checkoutUrl String?
  // Bank transfer
  bankReference String? @unique
  // Timestamps
  initiatedAt DateTime @default(now())
  completedAt DateTime?
  expiredAt DateTime?
  // Provider response
  resultCode Int?
  resultDescription String?
  transactionDate DateTime?
  rawCallbackJson String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events PaymentEvent[]
  refunds Refund[]

  @@index([orderId])
  @@index([createdAt])
  @@index([status])
  @@index([phone])
}

/// Append-only status history for a payment. Rows are never updated or deleted.
model PaymentEvent {
  id String @id @default(cuid())
  paymentId String
  fromStatus PaymentStatus?
  toStatus PaymentStatus
  source String
  note String?
  metadataJson String?
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([createdAt])
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  REJECTED
}

model Refund {
  id String @id @default(cuid())
  orderId String
  paymentId String
  amount Int
  currency String @default("KES")
  reason String
  status RefundStatus @default(REQUESTED)
  requestedById String?
  requestedByEmail String?
  // Provider round-trip
  providerRefundId String?
  providerResponseJson String?
  providerMessage String?
  failureReason String?
  processedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paymentId])
  @@index([status])
}

/// Durable record of administrative actions. Required for Kenya's
/// Data Protection Act 2019 accountability obligations.
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  actorEmail String?
  actorRole String?
  action String
  entity String
  entityId String?
  orderId String?
  beforeJson String?
  afterJson String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ---------- Marketing & service ----------

model Coupon {
 id String @id @default(cuid())
 code String @unique
 type DiscountType
 value Int // percent (e.g. 10) or fixed KES
 scope DiscountScope @default(ALL)
 scopeId String? // product/category/collection id
 minSpend Int @default(0)
 maxUses Int?
 usedCount Int @default(0)
 startsAt DateTime?
 expiresAt DateTime?
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 products Product[] @relation("CouponProducts")
 categories Category[] @relation("CouponCategories")
 collections Collection[] @relation("CouponCollections")
 orders Order[]

 @@index([code])
}

model DeliveryZone {
  id String @id @default(cuid())
  name String
  county String
  town String?
  fee Int
  expressFee Int?
  deliveryTime String?
  sameDay Boolean @default(false)
  nextDay Boolean @default(true)
  pickup Boolean @default(false)
  // Cash on delivery is opt-in per zone, never site-wide by default.
  codAvailable Boolean @default(false)
  minOrder Int @default(0)
  maxOrder Int?
  deliveryPartner String?
  active Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([county, town])
  @@index([county])
  @@index([active])
}

model Review {
 id String @id @default(cuid())
 productId String
 userId String?
 orderId String?
 rating Int
 title String?
 comment String?
 images String[] @default([])
 status ReviewStatus @default(PENDING)
 verifiedPurchase Boolean @default(false)
 helpfulCount Int @default(0)
 createdAt DateTime @default(now())

 product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
 user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
 order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

 @@index([productId, status])
 @@index([userId])
}

model OccasionReminder {
 id String @id @default(cuid())
 userId String
 personName String
 occasion OccasionType
 date DateTime
 relationship String?
 notes String?
 repeatsAnnually Boolean @default(true)
 notified Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 user User @relation(fields: [userId], references: [id], onDelete: Cascade)

 @@index([userId, date])
}

model InventoryTransaction {
 id String @id @default(cuid())
 productId String?
 variantId String?
 userId String?
 type InventoryTxnType
 quantity Int
 note String?
 refOrderItemId String?
 createdAt DateTime @default(now())

 product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
 variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
 user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

 @@index([productId])
 @@index([createdAt])
}

model AdminSetting {
 key String @id
 value String // JSON-encoded
 updatedAt DateTime @updatedAt
 updatedBy String?
}

// ---------- Customer segmentation ----------

model CustomerGroup {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  description String?
  discountPercent Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members CustomerGroupMember[]

  @@index([active])
}

model CustomerGroupMember {
  id String @id @default(cuid())
  groupId String
  userId String
  addedById String?
  createdAt DateTime @default(now())

  group CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// ---------- Marketing campaigns & promotions ----------

model Campaign {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  bannerImage String?
  bannerUrl String?
  headline String?
  subheadline String?
  status CampaignStatus @default(DRAFT)
  startsAt DateTime?
  endsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  promotions Promotion[]

  @@index([status])
  @@index([startsAt, endsAt])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
}

model Promotion {
  id String @id @default(cuid())
  name String
  description String?
  campaignId String?
  discountType DiscountType @default(PERCENTAGE)
  discountValue Int
  scope DiscountScope @default(ALL)
  minOrderValue Int @default(0)
  maxUses Int?
  usedCount Int @default(0)
  startsAt DateTime?
  endsAt DateTime?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([active])
  @@index([campaignId])
  @@index([startsAt, endsAt])
}

// ---------- Product view analytics ----------

model ProductView {
  id String @id @default(cuid())
  productId String
  userId String?
  sessionHash String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}
